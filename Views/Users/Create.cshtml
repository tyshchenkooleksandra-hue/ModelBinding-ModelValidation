@model ProductsValidation.Models.User

@{
    ViewData["Title"] = "Create user";
    string action = Context.Request.Path + Context.Request.QueryString;
}

<h1>Create user</h1>
<p class="text-muted">
    Fields are filled only from the query string, e.g.
    <code>/Users/Create?Id=5&amp;Name=Ann&amp;Email=ann@gmail.com&amp;Role=user</code>
</p>
<hr />
<div class="row">
    <div class="col-md-4">
        <form action="@action" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Role" class="control-label"></label>
                <input asp-for="Role" class="form-control" readonly />
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
