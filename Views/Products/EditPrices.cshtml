@model List<ProductsValidation.Models.ProductPrice>

@{
    Product.Category category = (Product.Category)ViewBag.Category;
    ViewData["Title"] = "Edit prices";
}

<h1>Edit prices: @category</h1>
<hr />

@if (Model.Count == 0)
{
    <p>There are no products in this category.</p>
}
else
{
    <form asp-action="EditPrices" asp-route-type="@category" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>
                            <input asp-for="@Model[i].Id" class="form-control" readonly />
                        </td>
                        <td>
                            <input asp-for="@Model[i].Name" class="form-control" readonly />
                        </td>
                        <td>
                            <input asp-for="@Model[i].Price" class="form-control" />
                            <span asp-validation-for="@Model[i].Price" class="text-danger"></span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <input type="submit" value="Save" class="btn btn-primary" />
    </form>
}

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>
